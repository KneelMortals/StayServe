rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================================
    // Account state and migration helpers
    // ======================================================================
    //
    // The profile is the source of truth for account state.  The
    // `registrationCompleted` marker is written by `completeRegistration`
    // (Admin SDK) after the OTP flow, and `isActive` is controlled by the
    // server / admin operations.  A client must never be able to manufacture
    // either value.
    //
    // There is one deliberately small migration exception.  Some profiles
    // which predate the marker do not have `registrationCompleted` (and some
    // old profiles do not have `isActive` either).  Locking those accounts
    // during a rules deployment would be an outage, so the migration mode
    // below lets only profiles which were created before a server supplied
    // cutoff use the legacy shape.
    //
    // The migration document is written with the Admin SDK, never by a
    // client:
    //
    //   system/registration
    //     legacyMode: true
    //     legacyCutoff: <timestamp>
    //
    // Deployment order:
    //   1. Create that document with a cutoff at the start of the
    //      migration (or immediately before deploying these rules).
    //   2. Backfill every legitimate user with
    //      registrationCompleted: true and isActive: true/false.  A
    //      profile which is still registrationCompleted: false is not a
    //      registered account and must remain unusable.
    //   3. Set legacyMode: false.  From that point on the marker and the
    //      active flag are fail-closed: a missing value is never accepted.
    //
    // While legacyMode is true, a newly-created client profile is not
    // allowed to masquerade as an old one.  The client bootstrap rule
    // below requires a current (not pre-cutoff) creation time when the
    // marker is absent, and a client-created profile without `createdAt`
    // is not eligible for the legacy exception.
    //
    // This document is intentionally not readable or writable by clients.
    // Admin SDK writes bypass Firestore rules, which is what makes the
    // migration switch and the backfill possible.

    function migrationDocumentExists() {
      return exists(/databases/$(database)/documents/system/registration);
    }

    function legacyMigrationEnabled() {
      return migrationDocumentExists() &&
        get(/databases/$(database)/documents/system/registration)
          .data.get('legacyMode', false) == true;
    }

    function legacyCutoffExists() {
      return legacyMigrationEnabled() &&
        get(/databases/$(database)/documents/system/registration)
          .data.get('legacyCutoff', null) != null;
    }

    // Whether the signed-in profile is an old profile which may be used
    // while the migration is in progress.  The strict `== null` test is
    // important: registrationCompleted: false is a real, incomplete
    // registration and must never receive the legacy exception.
    function legacyProfileIsEligible() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        legacyCutoffExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('registrationCompleted', null) == null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('createdAt', null) != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('createdAt', null) <
          get(/databases/$(database)/documents/system/registration)
            .data.get('legacyCutoff', null);
    }

    // The signed `stayServeVerifiedPhone` claim is the server's proof that
    // the account completed Firebase's phone challenge for one exact number.
    // The claim stores the number itself, so it stops matching the token as
    // soon as the live Auth phone is unlinked or replaced. A token which only
    // carries `phone_number` is not enough: the Admin SDK can attach a
    // number to an account without the SMS challenge ever being completed.
    //
    // Requiring the signed fact also prevents a stale Firestore
    // `phoneVerified` cache from granting service access after the provider
    // was unlinked and the device refreshed its session. A legacy
    // marker-less profile may use the token fact while the explicit migration
    // window is open; every current profile must also have the server-owned
    // cache flag.
    function hasVerifiedPhoneToken() {
      return request.auth != null &&
        request.auth.token.get('phone_number', '') != '' &&
        request.auth.token.get('stayServeVerifiedPhone', '') ==
        request.auth.token.get('phone_number', '');
    }

    // A live account is one whose registration has completed and which is
    // active.  The only exception is the explicitly controlled migration
    // path above.  Once legacyMode is false this helper is completely
    // fail-closed for both fields.
    function isLiveRegisteredAccount() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.get('registrationCompleted', false) == true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.get('isActive', false) == true
          ) ||
          (
            legacyProfileIsEligible() &&
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid))
                .data.get('isActive', false) == true ||
              get(/databases/$(database)/documents/users/$(request.auth.uid))
                .data.get('isActive', null) == null
            )
          )
        ) &&
        (
          // Administrators operate the platform and are not tenants. Their
          // existing accounts therefore do not need a phone migration.
          get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.get('role', '') == 'admin' ||
          // Students and owners may use the services only after Firebase has
          // verified a phone number for the account. The token proves that a
          // phone provider is present; the profile flag is the server-owned
          // cache used by the rules. A marker-less legacy profile is allowed
          // during the controlled migration even before that cache is filled.
          (
            hasVerifiedPhoneToken() &&
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid))
                .data.get('phoneVerified', false) == true ||
              (
                get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('phoneVerified', null) == null &&
                legacyProfileIsEligible()
              )
            )
          )
        );
    }

    // The same legacy exception as [legacyProfileIsEligible], but with the
    // already-read profile passed in. Reading the profile once keeps the
    // room-update rule below below Firestore's expression-evaluation limit.
    function legacyProfileIsEligibleWithProfile(profile) {
      return exists(/databases/$(database)/documents/system/registration) &&
        get(/databases/$(database)/documents/system/registration)
          .data.get('legacyMode', false) == true &&
        get(/databases/$(database)/documents/system/registration)
          .data.get('legacyCutoff', null) != null &&
        profile.get('registrationCompleted', null) == null &&
        profile.get('createdAt', null) != null &&
        profile.get('createdAt', null) <
        get(/databases/$(database)/documents/system/registration)
          .data.get('legacyCutoff', null);
    }

    function isLiveOwnerProfile(profile) {
      return profile.get('role', '') == 'owner' &&
        hasVerifiedPhoneToken() &&
        (
          profile.get('phoneVerified', false) == true ||
          (
            profile.get('phoneVerified', null) == null &&
            legacyProfileIsEligibleWithProfile(profile)
          )
        ) &&
        (
          (
            profile.get('registrationCompleted', false) == true &&
            profile.get('isActive', false) == true
          ) ||
          (
            legacyProfileIsEligibleWithProfile(profile) &&
            (
              profile.get('isActive', true) == true ||
              profile.get('isActive', null) == null
            )
          )
        );
    }

    // The live role is read from the profile, not from a stale token.  The
    // token's admin claim is still required below because it is used by
    // the client to decide when to refresh its session; however, the
    // claim alone can never grant access.
    function isLiveOwner() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isLiveOwnerProfile(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        );
    }

    // Administrative access requires all of the following:
    //   * a signed-in request;
    //   * the current custom claim (it may be stale, so it is not enough);
    //   * a live profile whose role is admin; and
    //   * an active profile.
    // The live profile check means a demoted or banned administrator loses
    // access immediately, even if their old token still says admin=true.
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.get('admin', false) == true &&
        isLiveRegisteredAccount() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isActive', false) == true;
    }

    // Relationship helpers.  They combine the document's party id with the
    // caller's **live** role.  Identity alone is not enough: a demoted owner
    // must not keep reading owner-side booking data with an old token, and a
    // user who is no longer a student must not keep reading tenant-side
    // booking and payment data.
    function isOwner(ownerId) {
      return request.auth != null &&
        request.auth.uid == ownerId &&
        isLiveOwner();
    }

    function isStudent(studentId) {
      return request.auth != null &&
        request.auth.uid == studentId &&
        isLiveRegisteredAccount() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'student';
    }

    // ======================================================================
    // Profile field policies
    // ======================================================================

    // Fields which a user may change on their own profile.  `role`,
    // `roleClaimed`, `isActive` and `registrationCompleted` are deliberately
    // absent.
    function changesOnlyAllowedSelfFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'profileImage',
        'fcmToken',
        'savedRooms',
        'pincode',
        'updatedAt',
      ]);
    }

    // A client may bootstrap a profile for itself, but it may not claim
    // the admin role or the registration-completed marker.  During the
    // legacy migration a profile without the marker is accepted only when
    // it was created after the cutoff (or has no client supplied
    // createdAt); it consequently cannot inherit the legacy exception.
    // The server's completeRegistration/onUserCreate flow is the only
    // writer which can set registrationCompleted to true.
    function profileBootstrapIsAllowed() {
      return request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
        request.resource.data.get('role', 'student') in ['student', 'owner'] &&
        request.resource.data.get('roleClaimed', false) == false &&
        request.resource.data.get('isActive', true) == true &&
        request.resource.data.get('registrationCompleted', false) == false &&
        !request.resource.data.keys().hasAny([
          'email',
          'phone',
          'emailVerified',
          'phoneVerified',
          'authProviders',
          'legacyEmailProofSource',
          'legacyEmailProofEmail',
          'emailVerifiedAt',
          'phoneVerifiedAt',
          'lastAuthSyncAt',
        ]) &&
        (
          request.resource.data.get('registrationCompleted', null) != null ||
          !legacyMigrationEnabled() ||
          (
            request.resource.data.get('createdAt', null) == null ||
            (
              legacyCutoffExists() &&
              request.resource.data.get('createdAt', null) >=
                get(/databases/$(database)/documents/system/registration)
                  .data.get('legacyCutoff', null)
            )
          )
        );
    }

    // ======================================================================
    // Room field policies
    // ======================================================================

    // These are the fields the Flutter room form currently edits.  Room
    // ownership, creation time, the document id, listing status and the
    // occupancy counter are not in this list.  The two server-owned state
    // fields are additionally compared below, so even a future list edit
    // cannot make them client-writable.
    // The photo list is server-owned. The server stages the object in the
    // trusted bucket, verifies that it belongs to this exact owner/room
    // path, and commits the canonical download URL in one transaction. A
    // client therefore cannot publish a URL from an attacker-controlled
    // project or reuse a trusted-bucket object which belongs to another
    // owner or room. Existing image lists remain readable and unchanged
    // while older listings are migrated.
    function roomCreateHasNoClientImages() {
      let images = request.resource.data.get('images', []);
      return images is list && images.size() == 0;
    }

    function roomImagesAreUnchanged() {
      return request.resource.data.get('images', null) ==
        resource.data.get('images', null);
    }

    // Whether an unpublished (draft) listing may be read by the caller.
    //
    // A draft belongs to its owner.  A live administrator may inspect it
    // (for example to remove an abandoned listing).  Every other account is
    // refused.
    //
    // The unfinished listings live in their own collection now, so this
    // helper only guards the published collection against a stray draft.
    function roomDraftIsVisibleToCaller() {
      return resource.data.get('status', '') != 'draft' ||
        resource.data.get('ownerId', '') == request.auth.uid ||
        isAdmin();
    }

    // Whether a published listing already uses this room id.
    //
    // The room id identifies one immutable listing lifetime. A draft may not
    // take the id of a published listing, otherwise the two documents would
    // describe two different listings under one id.
    function roomListingExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    // ----------------------------------------------------------------------
    // Public/private room-location policy
    // ----------------------------------------------------------------------
    //
    // Firestore rules work at document granularity: they cannot hide one
    // field while returning the rest of the same document. The exact address
    // therefore lives in `roomPrivate/{roomId}` and the public room document
    // contains only coarse locality data in the final stage.
    //
    // Older app versions still write the exact location into the public
    // document. During the compatibility window the server-owned switch
    // `system/locationPrivacy.allowClientExactLocationWrites` may be true.
    // The client cannot read or change that switch. Before the final rules
    // are deployed it must be set to false, after every public exact field
    // has been removed by the migration.
    function locationPrivacyConfigExists() {
      return exists(/databases/$(database)/documents/system/locationPrivacy);
    }

    function clientExactLocationWritesAllowed() {
      return locationPrivacyConfigExists() &&
        get(/databases/$(database)/documents/system/locationPrivacy)
          .data.get('allowClientExactLocationWrites', false) == true &&
        get(/databases/$(database)/documents/system/locationPrivacy)
          .data.get('finalized', false) != true;
    }

    function exactPublicLocationFieldsArePresent(data) {
      let location = data.get('location', {});
      return data.keys().hasAny([
        'address',
        'pincode',
        'latitude',
        'longitude'
      ]) ||
        (
          location is map &&
          location.keys().hasAny([
            'address',
            'pincode',
            'latitude',
            'longitude'
          ])
        );
    }

    function publicRoomCreateLocationIsAllowed(data) {
      let location = data.get('location', {});
      let coarseLocationIsValid = location is map &&
        (
          location.keys().hasOnly(['city', 'state']) &&
          location.get('city', '') is string &&
          location.get('state', '') is string
        );
      let hasExactFields = exactPublicLocationFieldsArePresent(data);

      return (!hasExactFields && coarseLocationIsValid) ||
        (hasExactFields && clientExactLocationWritesAllowed());
    }

    function publicLocationUpdateIsAllowed() {
      let changedKeys = request.resource.data
        .diff(resource.data)
        .affectedKeys();

      // Existing legacy documents may still contain exact fields while the
      // data migration runs. Only a write which changes one of those fields
      // needs the transitional server-owned switch.
      return !changedKeys.hasAny([
        'location',
        'address',
        'pincode',
        'latitude',
        'longitude'
      ]) || clientExactLocationWritesAllowed();
    }

    function roomCreateCannotForgeServerLocationFields() {
      return !request.resource.data.keys().hasAny([
        'geoCell',
        'locationRevision',
        'locationUpdatedAt',
        'locationPrivacyVersion'
      ]);
    }

    function roomCreateCannotForgeListingGeneration() {
      // The generation identifies one immutable lifetime of a room id. It is
      // assigned by the server and may never be chosen by a client.
      return !request.resource.data.keys().hasAny(['listingGeneration']);
    }

    function roomIdHasNoDeletionTombstone(roomId) {
      // A deleted room id stays reserved until its old photos and reviews
      // have really been removed. Reusing the id earlier would make the old
      // prefix cleanup delete the new listing's files.
      return !exists(/databases/$(database)/documents/roomDeletionTombstones/$(roomId));
    }

    function roomCreateCannotForgeCleanupLock() {
      // The cleanup lock is written by the server while it removes orphaned
      // Storage objects. A client-created lock could otherwise freeze the
      // owner's room edits until its forged expiry time.
      return !request.resource.data.keys().hasAny(['photoCleanupLock']);
    }

    function roomMonthlyRentIsValid(data) {
      let rent = data.get('monthlyRent', null);
      return rent is number &&
        rent >= 1000 &&
        rent <= 1000000;
    }

    function roomCapacityIsValid(data) {
      let capacity = data.get('occupancy', null);
      let current = data.get('currentOccupancy', 0);
      return capacity is int &&
        capacity >= 1 &&
        capacity <= 20 &&
        current is int &&
        current >= 0 &&
        current <= 20 &&
        current <= capacity;
    }

    function changesOnlyAllowedRoomFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title',
        'description',
        'monthlyRent',
        'securityDeposit',
        'location',
        'roomType',
        'furnishing',
        'availableFrom',
        'amenities',
        'occupancy',
        'genderPreference',
        'images',
        'updatedAt',
        'latitude',
        'longitude',
        'homeId',
        'homeName',
      ]);
    }

    function roomPhotoCleanupIsLocked() {
      let lock = resource.data.get('photoCleanupLock', null);
      return lock is map &&
        lock.get('expiresAt', request.time) > request.time;
    }

    function ownerMayUpdateRoom() {
      // `isOwner` already checks the live owner role and the owner id, so
      // repeating `isLiveOwner()` here would only expand the rules
      // expression beyond Firestore's evaluation limit.
      return isOwner(resource.data.get('ownerId', '')) &&
        !roomPhotoCleanupIsLocked() &&
        resource.data.get('deletionInProgress', false) != true &&
        changesOnlyAllowedRoomFields() &&
        publicLocationUpdateIsAllowed() &&
        roomImagesAreUnchanged() &&
        request.resource.data.get('ownerId', '') ==
          resource.data.get('ownerId', '') &&
        request.resource.data.get('createdAt', null) ==
          resource.data.get('createdAt', null) &&
        request.resource.data.get('listingGeneration', null) ==
          resource.data.get('listingGeneration', null) &&
        request.resource.data.get('currentOccupancy', 0) ==
          resource.data.get('currentOccupancy', 0) &&
        request.resource.data.get('status', null) ==
          resource.data.get('status', null) &&
        roomMonthlyRentIsValid(request.resource.data) &&
        roomCapacityIsValid(request.resource.data) &&
        request.resource.data.get('roomId', '') ==
          resource.data.get('roomId', '');
    }

    // The same edit policy for an unpublished draft.
    //
    // A draft may never change into a published listing through a client
    // write: the publication is a server operation which copies the draft
    // into the public collection.
    function ownerMayUpdateRoomDraft() {
      return ownerMayUpdateRoom() &&
        resource.data.get('status', '') == 'draft';
    }

    // ======================================================================
    // Users collection
    // ======================================================================
    match /users/{uid} {
      // A user may read their own profile even while registration is being
      // completed (the client needs it to render the role-selection flow)
      // and an admin may read profiles.  Other profile reads are denied.
      allow read: if request.auth != null &&
        (request.auth.uid == uid || isAdmin());

      // Only the account owner may create a profile for themselves.  The
      // role is limited to the two self-service roles, and the server-owned
      // registration marker can never be set to true by a client.
      allow create: if request.auth != null &&
        request.auth.uid == uid &&
        profileBootstrapIsAllowed();

      // Self-service profile edits are limited to harmless profile fields.
      // Role, activation and registration state are server-owned.  Admin
      // account reactivation uses the unbanUser callable, so even a live
      // administrator has no direct profile-field write path.
      allow update: if request.auth != null &&
        request.auth.uid == uid &&
        changesOnlyAllowedSelfFields();

      // Account deletion is exclusively a server operation.  The
      // deleteUserCompletely callable removes Firebase Auth and Firestore
      // together; a rules-level delete could leave a live Auth session.
      allow delete: if false;
    }

    // ======================================================================
    // Rooms collection
    // ======================================================================
    //
    // This collection holds the **published** listings only. An unfinished
    // listing lives in `roomDrafts`, which is owner-scoped — see below.
    //
    // The split is a security requirement, not a convenience: Firestore
    // rules cannot filter a collection query. A draft which shared this
    // collection would be returned by every query of it — including the
    // student search — and the single-document `get` rule could not hide it
    // from a collection query.
    match /rooms/{roomId} {
      // Listing and searching rooms is available to live, registered
      // accounts.  Public, pre-registration configuration lives in
      // publicSettings and is handled separately.
      allow get: if isLiveRegisteredAccount() &&
        roomDraftIsVisibleToCaller();

      // A collection query cannot be filtered by the rules, and the student
      // search deliberately pages through the collection without a status
      // filter (the status is applied in Dart, because a listing without the
      // field is still a valid listing).  The list therefore stays open for
      // live, registered accounts.  Every document of this collection is a
      // published listing, so an unfinished listing is never part of the
      // result.
      allow list: if isLiveRegisteredAccount();

      // A published listing is created by the **server**. The owner writes an
      // unfinished listing into `roomDrafts`, and `publishRoomListing` moves
      // it here once it is complete. A client may therefore never put a
      // document into the public collection — which is what keeps an
      // unfinished listing out of every collection query.
      allow create: if false;

      // Only the owner may edit the legitimate listing fields.  There is no
      // client path for status, currentOccupancy or any admin room update.
      allow update: if ownerMayUpdateRoom();

      // Listing deletion is exclusively a server operation.  The
      // deleteRoomListing callable verifies live owner/admin authority,
      // cancels open requests and removes the room with the Admin SDK.
      allow delete: if false;
    }

    // ======================================================================
    // Room drafts collection
    // ======================================================================
    //
    // An **unfinished** listing. It belongs to its owner and to nobody else.
    //
    // The document carries the complete listing payload, but it is never
    // offered to a student: it lives in its own collection, so no query of
    // the public `rooms` collection can return it, and the list rule below
    // refuses every query which does not filter by the caller's own id.
    match /roomDrafts/{roomId} {
      // A draft is readable by its owner and by a live administrator. Every
      // other account is refused.
      allow get: if isLiveRegisteredAccount() &&
        (
          resource.data.get('ownerId', '') == request.auth.uid ||
          isAdmin()
        );

      // The list is owner-scoped. The rule compares the stored owner id with
      // the signed-in account, so a query which does not filter by the
      // caller's own id can never be proven safe by the rules engine and is
      // refused.
      allow list: if isLiveOwner() &&
        resource.data.get('ownerId', '') == request.auth.uid;

      // A live administrator may list every draft. The rule does not depend
      // on the document at all, so the rules engine can prove it for any
      // query. It is a separate statement on purpose: combining it with the
      // owner-scoped rule through `||` would make the query analysis of the
      // owner query depend on the behaviour of the disjunction.
      allow list: if isAdmin();

      // A room is created by its live owner.  The owner id is the signed-in
      // owner and cannot be forged, and the advertised capacity must be a
      // positive number.
      //
      // `status` and `currentOccupancy` are **server-owned from the moment
      // the listing exists**.  A new listing is created as a `draft`: it is
      // invisible to the student search and it cannot be booked while its
      // photos and its private exact location are still missing.  The
      // `publishRoomListing` callable moves it into the public collection
      // once it is complete, so a client can never publish a half-finished
      // listing by itself.
      allow create: if isLiveOwner() &&
        roomIdHasNoDeletionTombstone(roomId) &&
        !roomListingExists(roomId) &&
        roomCreateHasNoClientImages() &&
        publicRoomCreateLocationIsAllowed(request.resource.data) &&
        roomCreateCannotForgeServerLocationFields() &&
        roomCreateCannotForgeListingGeneration() &&
        roomCreateCannotForgeCleanupLock() &&
        request.resource.data.get('ownerId', '') == request.auth.uid &&
        roomMonthlyRentIsValid(request.resource.data) &&
        roomCapacityIsValid(request.resource.data) &&
        request.resource.data.get('status', '') == 'draft' &&
        request.resource.data.get('currentOccupancy', 0) == 0 &&
        request.resource.data.get('roomId', roomId) == roomId;

      // The owner may correct the editable fields of their own draft. The
      // status stays `draft` and the server-owned fields stay untouched.
      allow update: if ownerMayUpdateRoomDraft();

      // A draft is removed by the server, which also cleans up its photos.
      allow delete: if false;
    }

    // A room id stays reserved until the durable cleanup of its deleted
    // listing has completed. Only the server may write these tombstones.
    match /roomDeletionTombstones/{roomId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    function liveOwnerOfRoom(roomId) {
      // The listing may be an unpublished draft: it lives in its own
      // collection until the owner publishes it. The exact address belongs to
      // the listing, so the owner of either collection may read it.
      return request.auth != null &&
        isLiveOwner() &&
        (
          (
            exists(/databases/$(database)/documents/rooms/$(roomId)) &&
            get(/databases/$(database)/documents/rooms/$(roomId))
              .data.get('ownerId', '') == request.auth.uid
          ) ||
          (
            exists(/databases/$(database)/documents/roomDrafts/$(roomId)) &&
            get(/databases/$(database)/documents/roomDrafts/$(roomId))
              .data.get('ownerId', '') == request.auth.uid
          )
        );
    }

    // ======================================================================
    // Private room locations
    // ======================================================================
    //
    // The exact street address and coordinates are stored here, in a
    // document which the ordinary public room query never returns.
    //
    // * the listing owner may read their own exact location;
    // * a live administrator may read it for support/migration work; and
    // * an accepted student receives it through `getRoomVisitDetails`, not
    //   through a direct collection read.
    //
    // Clients cannot write this collection. The owner-only callable uses the
    // Admin SDK and verifies the live room owner inside a transaction.
    match /roomPrivate/{roomId} {
      // A missing private document is a normal state during the staged
      // migration. The owner of the corresponding room must be able to read
      // that path so the client can fall back to the legacy location. The
      // listing's live owner id is canonical: a corrupt private ownerId must
      // not grant a different account access to the exact address.
      allow get: if isLiveRegisteredAccount() &&
        (
          isAdmin() ||
          liveOwnerOfRoom(roomId)
        );
      // The owner-facing client reads one deterministic document at a time.
      // Collection listing is reserved for administrators so a corrupt
      // private owner id cannot expose another listing's exact address.
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ======================================================================
    // Join Requests collection
    // ======================================================================
    match /joinRequests/{requestId} {
      // A request that does not exist may be read — the answer is then
      // simply "not found".  This avoids turning a missing document into a
      // misleading permission error in the app.
      allow get: if isLiveRegisteredAccount() &&
        (
          resource == null ||
          isStudent(resource.data.get('studentId', '')) ||
          isOwner(resource.data.get('ownerId', '')) ||
          isAdmin()
        );

      // The list may only return requests in which the live account is a
      // participant.  The admin branch is checked last so that a missing
      // participant field cannot cause an evaluation error.
      allow list: if isLiveRegisteredAccount() &&
        (
          isStudent(resource.data.get('studentId', '')) ||
          isOwner(resource.data.get('ownerId', '')) ||
          isAdmin()
        );

      // Join requests are server owned.  Clients never create, change or
      // delete a booking, its money terms, its approval state, or its
      // occupancy.  The createJoinRequest callable reads the room inside
      // the same transaction in which it creates the request and refuses a
      // missing room, a deletionInProgress room, or any non-available room.
      // The deleteRoomListing callable similarly cancels open requests and
      // retains their history instead of relying on a client delete.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ======================================================================
    // Platform-fee payments
    // ======================================================================
    match /payments/{paymentId} {
      allow get: if isLiveRegisteredAccount() &&
        (
          resource == null ||
          isAdmin() ||
          isStudent(resource.data.get('studentId', '')) ||
          isOwner(resource.data.get('ownerId', ''))
        );
      allow list: if isLiveRegisteredAccount() &&
        (
          isAdmin() ||
          isStudent(resource.data.get('studentId', '')) ||
          isOwner(resource.data.get('ownerId', ''))
        );
      // Written exclusively by the payment cloud functions.
      allow write: if false;
    }

    // ======================================================================
    // Reviews of a room
    // ======================================================================
    match /roomReviews/{reviewId} {
      // Room reviews are read through the server-owned `getRoomReviews`
      // callable. A direct collection read would let every live tenant
      // enumerate reviews across rooms and read the reviewer's uid/name.
      allow read: if false;
      // Reviews are written and removed by the server functions.
      allow write: if false;
    }

    // ======================================================================
    // Commission Invoices collection
    // ======================================================================
    match /commissionInvoices/{invoiceId} {
      allow get: if isLiveRegisteredAccount() &&
        (
          resource == null ||
          isOwner(resource.data.get('ownerId', '')) ||
          isStudent(resource.data.get('tenantId', '')) ||
          isAdmin()
        );
      allow list: if isLiveRegisteredAccount() &&
        (
          isOwner(resource.data.get('ownerId', '')) ||
          isStudent(resource.data.get('tenantId', '')) ||
          isAdmin()
        );
      // Invoices are created by the server.  The only client write is the
      // live admin's existing-invoice status/bookkeeping update.  The
      // affected-key whitelist also protects invoiceId, roomId, ownerId,
      // tenantId, joinRequestId, the money/commission fields and createdAt.
      allow create: if false;
      allow delete: if false;
      allow update: if isAdmin() &&
        request.resource.data.get('status', '') in ['paid', 'cancelled'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'paidAt',
          'paymentReference',
          'paymentMethod',
          'upiTransactionId',
          'cancelledAt',
          'updatedAt',
        ]);
    }

    // Moderation audit records are written only by the server when an
    // administrator removes a review. Clients cannot inspect or alter them.
    match /reviewDeletionAudit/{auditId} {
      allow read, write: if false;
    }

    // The latest deletion pointer is trusted server state for idempotent
    // retries. It is not moderation history and must remain invisible to
    // clients.
    match /reviewDeletionState/{stateId} {
      allow read, write: if false;
    }

    // Server-only notification attribution and administrator-message
    // delivery state. They contain participant uids and must never be
    // readable by a notification recipient.
    match /notificationAttributions/{attributionId} {
      allow read, write: if false;
    }

    match /adminMessageNotificationOperations/{operationId} {
      allow read, write: if false;
    }

    // Durable state for a verified-email linking operation and its per-account
    // lock. They contain the uid, address and a hash of the one-time proof so
    // a partial Auth/Firestore write can be retried safely and concurrent
    // different-address links are serialised. Only trusted server code may
    // access them.
    match /emailLinkOperations/{operationId} {
      allow read, write: if false;
    }

    // A rollback marker for an incomplete registration is server-only. It
    // makes the rollback and the registration transaction mutually exclusive.
    match /registrationRollbackOperations/{operationId} {
      allow read, write: if false;
    }

    // ======================================================================
    // Notifications collection
    // ======================================================================
    match /notifications/{notificationId} {
      // A client may read only its own notifications.  `read` is retained
      // for compatibility with the current Flutter client; `isRead` is
      // accepted for newer clients.
      allow get: if isLiveRegisteredAccount() &&
        (
          resource == null ||
          resource.data.get('userId', '') == request.auth.uid
        );
      allow list: if isLiveRegisteredAccount() &&
        resource.data.get('userId', '') == request.auth.uid;

      // Notifications are written by the server.  A client may not create
      // one for itself or for anybody else.
      allow create: if false;

      // The only client write is the recipient's read bookkeeping.  The
      // affected-key whitelist prevents changes to userId, title, body,
      // type, data and every other routing/content field.
      allow update: if isLiveRegisteredAccount() &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read',
          'isRead',
          'readAt',
        ]);

      // Deletion is a server/maintenance operation.
      allow delete: if false;
    }

    // ======================================================================
    // Conversations collection
    // ======================================================================

    // A client conversation is strictly a two-party conversation.  The
    // participant ids must be distinct; otherwise the same account could
    // occupy both slots and leave a message with no legitimate recipient.
    function isTwoPartyParticipantList(participantIds) {
      return participantIds is list &&
        participantIds.size() == 2 &&
        participantIds[0] != participantIds[1];
    }

    // Personal student-owner blocks are stored in a server-owned, directional
    // collection. The client cannot read or write these documents, but the
    // rules can use them to refuse a new message as soon as either side has
    // blocked the other.
    function pairIsBlocked(firstUserId, secondUserId) {
      return firstUserId is string &&
        secondUserId is string &&
        firstUserId != secondUserId &&
        (
          exists(/databases/$(database)/documents/userBlocks/$(firstUserId)/blockedUsers/$(secondUserId)) ||
          exists(/databases/$(database)/documents/userBlocks/$(secondUserId)/blockedUsers/$(firstUserId))
        );
    }

    function conversationPairIsBlocked(participantIds) {
      return isTwoPartyParticipantList(participantIds) &&
        pairIsBlocked(participantIds[0], participantIds[1]);
    }

    match /userBlocks/{blockerId}/blockedUsers/{blockedUserId} {
      // The block state is changed only by the server callables. It is
      // intentionally invisible to ordinary clients; they receive the two
      // booleans they need through the interaction callables instead.
      allow read, write: if false;
    }

    // The real administrator uid is kept in a server-only operation so the
    // tenant-readable conversation can use an opaque support identity. The
    // mapped administrator may still read their own support channel.
    function isMappedAdminSupportAdmin(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
      let operation = get(/databases/$(database)/documents/adminSupportConversationOperations/$(conversationId));
      return request.auth != null &&
        isAdmin() &&
        conversation.data.get('conversationType', '') == 'adminSupport' &&
        operation.data.get('conversationId', '') == conversationId &&
        operation.data.get('adminUid', '') == request.auth.uid &&
        operation.data.get('adminIdentity', '') == conversation.data.get('adminId', '') &&
        operation.data.get('targetUid', '') in conversation.data.get('participantIds', []);
    }

    // Legacy support conversations used to contain the administrator's raw
    // uid in the parent and message fields. They are refused directly until
    // the server has migrated them to the opaque identity.
    function isOpaqueAdminSupportConversation(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
      return !exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
        conversation.data.get('conversationType', '') != 'adminSupport' ||
        conversation.data.get('adminId', '') == 'adminIdentities/support/profile';
    }

    // Whether this conversation is an administrator-support channel.
    //
    // A support channel is written by trusted callables only. The client
    // route (`sendAdminSupportReply` and
    // `markAdminSupportConversationRead`) validates the live support target,
    // the durable administrator mapping and the live mapped administrator,
    // and it writes the message, the preview and the unread counters in one
    // transaction. A direct client write could otherwise forge a preview,
    // move an unread counter without a message, or leave a reply in a channel
    // whose administrator can no longer answer.
    function isAdminSupportConversation(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.get('conversationType', '') == 'adminSupport';
    }

    function isAdminSupportPrivacyMigrationInProgress(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
      return exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        conversation.data.get('privacyMigrationInProgress', false) == true;
    }

    match /conversations/{conversationId} {
      allow get: if isLiveRegisteredAccount() &&
        isOpaqueAdminSupportConversation(conversationId) &&
        !isAdminSupportPrivacyMigrationInProgress(conversationId) &&
        (
          resource == null ||
          request.auth.uid in resource.data.get('participantIds', []) ||
          isMappedAdminSupportAdmin(conversationId)
        );
      allow list: if isLiveRegisteredAccount() &&
        isOpaqueAdminSupportConversation(conversationId) &&
        !isAdminSupportPrivacyMigrationInProgress(conversationId) &&
        (
          request.auth.uid in resource.data.get('participantIds', []) ||
          isMappedAdminSupportAdmin(conversationId)
        );

      // The support-channel markers are server-owned. They identify the
      // trusted route which created the conversation and must never be
      // editable by either participant.
      function serverOwnedConversationMetadataIsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'conversationType',
          'adminId',
          'adminVerified',
          'createdByServer',
        ]);
      }

      // Conversation creation is server-owned. The `openConversation`
      // callable verifies a live student-owner pair: a student may contact
      // the owner of the supplied room, and either booking participant may
      // open the conversation through a verified request. A client may
      // therefore not create a conversation with an arbitrary uid.
      allow create: if false;

      // The participant list, conversation id, support-channel markers,
      // creation time and listing context are immutable: a participant may
      // not add a third party, re-point the conversation, change the trusted
      // admin identity or overwrite the server-owned names and room title.
      // Only the bookkeeping fields the Flutter client maintains (last
      // message, unread counts and timestamps) may change.
      //
      // An administrator-support channel is excluded: its bookkeeping is
      // written by the trusted support callables.
      allow update: if isLiveRegisteredAccount() &&
        isOpaqueAdminSupportConversation(conversationId) &&
        !isAdminSupportPrivacyMigrationInProgress(conversationId) &&
        !isAdminSupportConversation(conversationId) &&
        resource.data.get('deletionInProgress', false) != true &&
        request.auth.uid in resource.data.get('participantIds', []) &&
        resource.data.get('participantIds', []) ==
          request.resource.data.get('participantIds', []) &&
        request.resource.data.get('roomId', '') ==
          resource.data.get('roomId', '') &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'lastMessage',
            'lastMessageAt',
          ]) ||
          !conversationPairIsBlocked(resource.data.get('participantIds', []))
        ) &&
        request.resource.data.get('conversationId', '') ==
          resource.data.get('conversationId', '') &&
        request.resource.data.get('createdAt', null) ==
          resource.data.get('createdAt', null) &&
        serverOwnedConversationMetadataIsUnchanged() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'updatedAt',
          'unreadCount',
        ]);
    }

    // The listing/request context of a conversation is server-owned. It
    // keeps the correct room title when the same student and owner discuss
    // more than one listing.
    match /conversations/{conversationId}/contexts/{contextId} {
      allow read, write: if false;
    }

    // ======================================================================
    // Messages subcollection
    // ======================================================================
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if isLiveRegisteredAccount() &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        isOpaqueAdminSupportConversation(conversationId) &&
        !isAdminSupportPrivacyMigrationInProgress(conversationId) &&
        (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.get('participantIds', []) ||
          isMappedAdminSupportAdmin(conversationId)
        );

      // In an administrator-support conversation, the administrator may not
      // write a message directly from a client. The trusted sendAdminMessage
      // callable uses the Admin SDK, which bypasses Firestore rules and adds
      // the server-owned admin sender markers.
      function isAdminSupportAdmin() {
        let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
        return request.auth != null &&
          conversation.data.get('conversationType', '') == 'adminSupport' &&
          request.auth.uid == conversation.data.get('adminId', '');
      }

      // A sender may create only a message for the other participant in the
      // containing conversation.  The payload's conversation id must match
      // the document path, and no fields outside the Flutter message model
      // may be introduced.
      //
      // An administrator-support channel is excluded: the support reply is
      // written by the trusted `sendAdminSupportReply` callable, which
      // validates the live target, the durable administrator mapping and the
      // live mapped administrator, and which keeps the message, the preview
      // and the unread counters in one transaction.
      allow create: if isLiveRegisteredAccount() &&
        exists(/databases/$(database)/documents/conversations/$(conversationId)) &&
        isOpaqueAdminSupportConversation(conversationId) &&
        !isAdminSupportConversation(conversationId) &&
        !isAdminSupportAdmin() &&
        !isMappedAdminSupportAdmin(conversationId) &&
        !isAdminSupportPrivacyMigrationInProgress(conversationId) &&
        get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.get('deletionInProgress', false) != true &&
        request.resource.data.keys().hasOnly([
          'conversationId',
          'senderId',
          'receiverId',
          'content',
          'type',
          'createdAt',
          'readAt',
          'roomId',
          'imageUrl',
          'messageId',
        ]) &&
        request.resource.data.get('conversationId', '') == conversationId &&
        request.resource.data.get('senderId', '') == request.auth.uid &&
        request.resource.data.get('receiverId', '') != request.auth.uid &&
        isTwoPartyParticipantList(
          get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.get('participantIds', [])
        ) &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId))
          .data.get('participantIds', []) &&
        request.resource.data.get('receiverId', '') in
          get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.get('participantIds', []) &&
        !pairIsBlocked(
          request.auth.uid,
          request.resource.data.get('receiverId', '')
        );
    }

    // ======================================================================
    // Durable account-deletion jobs
    // ======================================================================
    //
    // These jobs contain the uid while they are pending and are written only
    // by trusted server code. A client must not be able to enqueue, inspect
    // or cancel a deletion job.
    match /accountDeletionJobs/{jobId} {
      allow read, write: if false;
    }

    // ======================================================================
    // Settings collection (admin only write)
    // ======================================================================
    match /settings/{docId} {
      allow read: if isLiveRegisteredAccount();
      allow write: if isAdmin();
    }

    // ======================================================================
    // Public settings
    // ======================================================================
    // These are the few settings that have to be readable before the user
    // signs in.  They are public by design; writes still require a live
    // administrator.
    match /publicSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ======================================================================
    // OTP verification codes
    // ======================================================================
    match /otpCodes/{docId} {
      allow read, write: if false;
    }

    // ======================================================================
    // The quota of the OTP sources
    // ======================================================================
    match /otpSendQuota/{docId} {
      allow read, write: if false;
    }

    // ======================================================================
    // The lock of a transaction reference
    // ======================================================================
    match /paymentReferences/{docId} {
      allow read, write: if false;
    }

    // ======================================================================
    // The lock of a booking request
    // ======================================================================
    match /joinRequestLocks/{docId} {
      allow read, write: if false;
    }

    // ======================================================================
    // Rules-migration switch
    // ======================================================================
    // Only the Admin SDK may write this document.  It is deliberately
    // invisible to clients so that a client cannot turn the transitional
    // legacy exception back on.
    match /system/{document=**} {
      allow read, write: if false;
    }
  }
}
