rules_version = '2';

// ---------------------------------------------------------------------------
// Firebase Storage rules.
//
// The deployed rules used to be
//
//     match /{allPaths=**} { allow read, write: if false; }
//
// which denied every client upload. Room-photo uploads are now mediated by
// server callables, so client writes are denied again. The rules below grant
// only the narrow reads and administrator namespace access which are still
// required.
//
// The Firestore profile is the source of truth for account activity and role.
// A custom claim alone is not enough: it stays in an already-issued ID token
// until that token expires, so a demoted admin could otherwise keep accessing
// administrator files.
// ---------------------------------------------------------------------------
service firebase.storage {
  match /b/{bucket}/o {

    // The signed `stayServeVerifiedPhone` claim is the server's proof that
    // the account completed Firebase's phone challenge for one exact number.
    // The claim stores the number itself, so it stops matching the token as
    // soon as the live Auth phone is unlinked or replaced. A token which only
    // carries `phone_number` is not enough: the Admin SDK can attach a
    // number to an account without the SMS challenge ever being completed.
    //
    // The signed token fact is the Storage gate: the Firestore `phoneVerified`
    // value is only a cache and must never grant access by itself.
    function hasVerifiedPhoneToken() {
      return request.auth != null &&
        request.auth.token.get('phone_number', '') != '' &&
        request.auth.token.get('stayServeVerifiedPhone', '') ==
        request.auth.token.get('phone_number', '');
    }

    // A live account has completed its registration and is active.
    // Students and owners must also have a Firebase-verified phone before
    // they may use owner/student services. Administrators are exempt because
    // they operate the platform rather than rent or list a room.
    function isLiveRegisteredAccount() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('registrationCompleted', false) == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('isActive', false) == true &&
        (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
            .data.get('role', '') == 'admin' ||
          hasVerifiedPhoneToken()
        );
    }

    function isLiveAdmin() {
      return isLiveRegisteredAccount() &&
        request.auth.token.get('admin', false) == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'admin';
    }

    // -----------------------------------------------------------------------
    // The photos of a room listing.
    //
    // They are stored under
    //
    //     rooms/{ownerUid}/{roomId}/{fileName}
    //
    // Client writes are denied in this namespace. The server-mediated room
    // photo callable validates the live owner, the live listing, the image
    // bytes, the trusted bucket and the exact owner/room path before the
    // Admin SDK writes the object. It also records a durable upload
    // operation, applies an owner quota and sweeps abandoned objects.
    //
    // Reading is open to live, registered accounts — the photos are shown to
    // the students inside the app.
    // -----------------------------------------------------------------------
    match /rooms/{ownerId}/{roomId}/{fileName} {
      allow read: if isLiveRegisteredAccount();
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // Administrator-owned files.
    //
    // This grant is deliberately limited to its own namespace. A broad
    // `/{allPaths=**}` admin-write rule also matched the room-image rule
    // above, and Firebase combines matching grants with OR. A live admin
    // could therefore overwrite or delete another owner's room photos.
    // Moderation cleanup of a room photo must go through a server callable
    // using the Admin SDK instead.
    // -----------------------------------------------------------------------
    match /admin/{fileName} {
      allow read: if isLiveAdmin();
      allow write: if isLiveAdmin();
    }

    // -----------------------------------------------------------------------
    // Everything else.
    //
    // There is no generic compatibility grant. A registered tenant may read
    // the room-photo namespace above, but cannot enumerate or read private
    // administrator files or an unrelated object under an unknown prefix.
    // No client may write an object which has no explicit namespace rule.
    // -----------------------------------------------------------------------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
