rules_version = '2';

// ---------------------------------------------------------------------------
// Firebase Storage rules.
//
// The deployed rules used to be
//
//     match /{allPaths=**} { allow read, write: if false; }
//
// which denies **every** upload — that is why the owner could not attach a
// photo to a listing ("auth issue while uploading pics as owner"). The rules
// below open the storage up again, but only for live, registered accounts
// with the matching role.
//
// The Firestore profile is the source of truth for the role. A custom claim
// alone is not enough: it stays in an already-issued ID token until that
// token expires, so a demoted admin could otherwise keep writing files.
// ---------------------------------------------------------------------------
service firebase.storage {
  match /b/{bucket}/o {

    // A live account has completed its registration and is active.
    function isLiveRegisteredAccount() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('registrationCompleted', false) == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('isActive', false) == true;
    }

    function isLiveOwner() {
      return isLiveRegisteredAccount() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'owner';
    }

    function isLiveAdmin() {
      return isLiveRegisteredAccount() &&
        request.auth.token.get('admin', false) == true &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'admin';
    }

    // The deletion tombstone is committed in the same transaction as the
    // room's `deletionInProgress` marker. It therefore covers both the
    // deletion-in-progress state and the interval after the room document has
    // been removed. Do not also read the room document here: Storage Rules
    // permit at most two Firestore documents in one evaluation, and this
    // write already needs the live profile plus the tombstone.
    function roomPhotoWriteIsAllowed(roomId) {
      let tombstone =
        /databases/(default)/documents/roomDeletionTombstones/$(roomId);
      return !firestore.exists(tombstone);
    }

    // -----------------------------------------------------------------------
    // The photos of a room listing.
    //
    // They are stored under
    //
    //     rooms/{ownerUid}/{roomId}/{fileName}
    //
    // The uid of the owner is part of the path, so the rules can check it
    // without trusting a field sent by the client. A signed-in owner may
    // only write below their own folder, and can never upload into the
    // folder of another owner.
    //
    // Reading is open to live, registered accounts — the photos are shown to
    // the students inside the app.
    // -----------------------------------------------------------------------
    match /rooms/{ownerId}/{roomId}/{fileName} {
      allow read: if isLiveRegisteredAccount();
      allow write: if isLiveOwner() &&
        request.auth.uid == ownerId &&
        roomPhotoWriteIsAllowed(roomId) &&
        (
          request.resource == null ||
          (
            request.resource.size > 0 &&
            request.resource.size <= 5 * 1024 * 1024 &&
            request.resource.contentType.matches('image/.*')
          )
        );
    }

    // -----------------------------------------------------------------------
    // Administrator-owned files.
    //
    // This grant is deliberately limited to its own namespace. A broad
    // `/{allPaths=**}` admin-write rule also matched the room-image rule
    // above, and Firebase combines matching grants with OR. A live admin
    // could therefore overwrite or delete another owner's room photos.
    // Moderation cleanup of a room photo must go through a server callable
    // using the Admin SDK instead.
    // -----------------------------------------------------------------------
    match /admin/{fileName} {
      allow read: if isLiveRegisteredAccount();
      allow write: if isLiveAdmin();
    }

    // -----------------------------------------------------------------------
    // Everything else.
    //
    // Reading remains open to live, registered accounts for compatibility
    // with the existing profile/media paths. No client may write an object
    // which has no explicit namespace rule above.
    // -----------------------------------------------------------------------
    match /{allPaths=**} {
      allow read: if isLiveRegisteredAccount();
      allow write: if false;
    }
  }
}
