# Environment variables for the StayServe Cloud Functions.
#
# Copy this file to `functions/.env` and fill in the values you have.
# `functions/.env` is git-ignored — never commit real credentials.
#
# Every variable below is OPTIONAL: without a delivery provider the OTP is
# written to the Cloud Function logs instead of being sent, and the payment
# functions fall back to the defaults shown.

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# The UPI address that receives EVERY payment collected through the app.
# Must match `AppConstants.platformUpiVpa` in
# `lib/core/constants/app_constants.dart`.
PLATFORM_UPI_VPA=shauryaprataprai461-2@oksbi

# The payee name shown inside the UPI app.
PLATFORM_UPI_NAME=StayServe

# Percentage of the monthly rent charged as the platform fee.
# The admin can override this at runtime from Admin → Settings; this value is
# only the fallback.
PLATFORM_FEE_PERCENTAGE=30

# ---------------------------------------------------------------------------
# OTP delivery — email (pick one)
# ---------------------------------------------------------------------------
# Brevo — no domain required. The sender only has to be a verified email
# address (Brevo emails you a confirmation link), and mail can be sent to
# ANY recipient. Free tier: 300 emails/day.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
# BREVO_FROM_EMAIL=you@gmail.com

# SendGrid — needs a verified sender/domain. Free tier: 100 emails/day.
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# Resend — needs a verified domain. Free tier: 3,000 emails/month.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The sender shown in the mail. For SendGrid this is the bare address
# (no-reply@yourdomain.com); for Resend it is the full RFC 5322 form
# ("Stay Serve <no-reply@yourdomain.com>").
# OTP_FROM_EMAIL=no-reply@stayserve.app
# OTP_FROM_NAME=StayServe

# ---------------------------------------------------------------------------
# OTP delivery — mobile (pick one)
# ---------------------------------------------------------------------------
#
# Phone verification is currently SWITCHED OFF, because SMS costs money.
# While `REQUIRE_PHONE_OTP` is false:
#   * `sendOtp` / `verifyOtp` refuse the `mobile` channel, so no SMS can
#     ever leave the backend and nothing can be spent on one;
#   * `completeRegistration` only requires a verified email address and
#     stores the phone number as optional contact information.
#
# To switch phone verification back on: set `REQUIRE_PHONE_OTP=true`,
# configure one of the providers below, redeploy, and re-enable the phone
# step in the app.
REQUIRE_PHONE_OTP=false

# The country code that is added when a user types a bare 10-digit Indian
# mobile number (`9876543210` -> `+919876543210`). Without this the SMS
# provider receives an unrouteable 10-digit number.
DEFAULT_COUNTRY_CODE=91

# Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567

# Fast2SMS
# FAST2SMS_API_KEY=xxxxxxxxxxxxxxxxxxxx
#
# The route decides whether you need DLT registration:
#   q   Quick SMS - no DLT, works for every Indian number (DND included),
#       but costs more per message and each campaign is reviewed by their
#       team before release. This is the default.
#   dlt DLT SMS - needs a DLT entity, sender ID and content template
#       (entity registration costs ~INR 5,900 once at the operator portal),
#       but is much cheaper per message.
# FAST2SMS_ROUTE=q
# Only used on the 'dlt' route.
# FAST2SMS_SENDER_ID=TXTLNS

# MSG91
# MSG91_AUTH_KEY=xxxxxxxxxxxxxxxxxxxx
# MSG91_TEMPLATE_ID=xxxxxxxxxxxxxxxxxxxx
