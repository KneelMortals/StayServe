{
  "name": "stayserve-functions",
  "description": "Cloud Functions for StayServe",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "build": "tsc",
    "watch": "tsc -w"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@firebase/database-compat": "2.1.7",
    "@firebase/database": "1.1.5"
  },
  "private": true
}
