# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Stray duplicated generated files moved out of lib/ during repair
/_backup_stray_generated/

# Local mail.tm inbox credentials (contains a bearer token)
/.mail_inbox.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/macos/Flutter/ephemeral/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cloud Functions environment files
#
# `functions/.env` holds the live Brevo API key, the OTP sender address and
# the platform UPI details. It must never end up in version control —
# `functions/.env.example` is the template that is meant to be committed.
/functions/.env
/functions/.env.*
!/functions/.env.example
/android/build/